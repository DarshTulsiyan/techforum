<h1>Edit User</h1>

<% if @user.errors.any? %>
  <div>
    <h3>Unable to update user:</h3>

    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user do |form| %>

  <div>
    <%= form.label :username %>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.submit "Update User" %>
  </div>

<% end %>

<%= link_to "Back to Users", users_path %>