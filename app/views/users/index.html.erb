<% content_for :title, "Users" %>

<h1>Users</h1>

<div id="users">
  <% @users.each do |user| %>
    <%= render user %>
      <div>
      <%= link_to "Show this user", user_path(user) %>
      <%= link_to "Edit", edit_user_path(user) %>

      <%= button_to "Delete", user_path(user), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
</div>

<%= link_to "New user", new_user_path %>
