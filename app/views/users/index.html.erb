<% content_for :title, "Users" %>

<div class="page-header">
  <div>
    <h1>Users</h1>
    <p class="page-subtitle">
      View and manage TechForum users.
    </p>
  </div>

  <%= link_to "＋ New User", new_user_path, class: "button button-primary" %>
</div>

<% if @users.any? %>

  <div class="user-list">

    <% @users.each do |user| %>

      <div class="user-card">

        <div class="user-info">
          <h2>
            <%= user.username %>
          </h2>
        </div>

        <div class="user-actions">
          <%= link_to "View", user_path(user), class: "user-link" %>

          <%= link_to "Edit",
                      edit_user_path(user),
                      class: "user-link" %>

          <%= button_to "Delete",
                        user_path(user),
                        method: :delete,
                        class: "delete-link",
                        form: {
                          onsubmit: "return confirm('Are you sure you want to delete this user?');"
                        } %>
        </div>

      </div>

    <% end %>

  </div>

<% else %>

  <div class="empty-state">
    <h2>No users yet</h2>
    <p>Create the first TechForum user.</p>

    <%= link_to "New User",
                new_user_path,
                class: "button button-primary" %>
  </div>

<% end %>