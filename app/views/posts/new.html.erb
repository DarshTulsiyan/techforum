<h1>New Post</h1>

<% if @user_not_found %>
  <p style="color: red">Username not found. Create a user first, then submit the post again.</p>
<% end %>

<form action="/posts" method="post">
  <label>Your username</label>
  <input type="text" name="post[username]" placeholder="your username"><br>
  <input type="text" name="post[title]" placeholder="title"><br>
  <textarea name="post[body]" placeholder="body"></textarea><br>
  <input type="text" name="post[category]" placeholder="category"><br>
  <input type="text" name="post[tags]" placeholder="tags, comma, separated"><br>
  <button type="submit">Create</button>
</form>