<div class="post-detail">

  <div class="post-detail-card">

    <div class="post-detail-header">
      <span class="post-category"><%= @post.category %></span>

      <h1><%= @post.title %></h1>

      <div class="post-meta">
        <span><%= @post.upvotes_count %> upvotes</span>

        <% if @post.tags.any? %>
          <span>·</span>
          <span><%= @post.tags.map(&:name).join(", ") %></span>
        <% end %>
      </div>
    </div>

    <div class="post-body">
      <%= simple_format(@post.body) %>
    </div>

    <div class="upvote-section">
      <form action="/posts/<%= @post.id %>/upvote" method="post">
        <input
          type="text"
          name="username"
          placeholder="Enter your username"
        >

        <button type="submit" class="button button-primary">
          Upvote
        </button>
      </form>
    </div>

  </div>


  <!-- Comments -->

  <div class="comments-section">

    <h2>Comments</h2>

    <% if @comments.any? %>

      <div class="comments-list">

        <% @comments.each do |comment| %>

          <div class="comment-card">

            <div class="comment-content">

              <div class="comment-meta">
                <strong><%= comment.user.username %></strong>
                <span>commented</span>
              </div>

              <p><%= comment.body %></p>


              <!-- Replies -->

              <% if comment.replies.any? %>

                <div class="replies">

                  <% comment.replies.each do |reply| %>

                    <div class="reply-card">

                      <div>
                        <div class="comment-meta">
                          <strong><%= reply.user.username %></strong>
                          <span>replied</span>
                        </div>

                        <p><%= reply.body %></p>
                      </div>

                    </div>

                  <% end %>

                </div>

              <% end %>


              <!-- Reply form -->

              <div class="reply-form">

                <form action="<%= post_comments_path(@post) %>" method="post">

                  <input
                    type="hidden"
                    name="comment[parent_id]"
                    value="<%= comment.id %>"
                  >

                  <input
                    type="text"
                    name="comment[username]"
                    placeholder="Your username"
                  >

                  <textarea
                    name="comment[body]"
                    placeholder="Write a reply..."
                  ></textarea>

                  <button type="submit" class="button button-secondary">
                    Reply
                  </button>

                </form>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="empty-state">
        <p>No comments yet. Start the conversation.</p>
      </div>

    <% end %>


    <!-- New comment -->

    <div class="comment-form">

      <h3>Join the discussion</h3>

      <form action="/posts/<%= @post.id %>/comments" method="post">

        <input
          type="text"
          name="comment[username]"
          placeholder="Your username"
        >

        <textarea
          name="comment[body]"
          placeholder="Write a comment..."
        ></textarea>

        <button type="submit" class="button button-primary">
          Comment
        </button>

      </form>

    </div>

  </div>


  <!-- Related posts -->

  <% if @related_posts.any? %>

    <div class="related-section">

      <div class="section-heading">
        <h2>Related Posts</h2>
      </div>

      <div class="related-posts">

        <% @related_posts.each do |related_post| %>

          <div class="related-post">

            <h3>
              <%= link_to related_post.title, related_post %>
            </h3>

            <p>
              <%= related_post.category %>
              ·
              <%= related_post.upvotes_count %> upvotes
              ·
              <%= related_post.tags.map(&:name).join(", ") %>
            </p>

          </div>

        <% end %>

      </div>

    </div>

  <% end %>


  <div class="back-link">
    <%= link_to "← Back to Discussions", posts_path %>
  </div>

</div>